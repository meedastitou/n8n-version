s = {};\nfor (const r of rows) {\n  const key = [r.observation, r.marque, r.status ?? ''].join('||');\n\n  if (!groups[key]) {\n    groups[key] = {\n      observation: r.observation,\n      marque: r.marque,\n      Demandeur: r.Demandeur,\n      id_da: r.id_da,\n      lignes: []\n    };\n    // status ajouté seulement s'il existe\n    if (r.status) groups[key].status = r.status;\n  }\n\n  groups[key].lignes.push({\n    code_sage: r.code_article,\n    effectif: r.quantite\n  });\n}\n\n// Un item par groupe => un appel API par observation\nreturn Object.values(groups).map(g => ({\n  json: {\n    donnees: [g]\n  }\n}));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1040,352],"id":"5e5d9e0c-5d0f-4a54-a873-5015c946675b","name":"Code11"},{"parameters":{"operation":"executeQuery","query":"SELECT\n    CASE WHEN COUNT(p.XNFACT_0) > 0 THEN 'EXISTE' ELSE 'INEXISTANT' END AS status,\n    COUNT(p.XNFACT_0)                     AS nb_lignes\nFROM (SELECT 1 AS dummy) d\nLEFT JOIN BASE1.PRECEIPT p\n       ON p.XNFACT_0 = '{{ $json.N_Facture }}'"},"type":"n8n-nodes-base.microsoftSql","typeVersion":1.1,"position":[-672,384],"id":"437b73e2-edd2-45e6-b2d4-7580f25a6999","name":"Microsoft SQL1","credentials":{"microsoftSql":{"id":"HW9ko65N6UH3Mtv7","name":"SageX3_241"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"bae452c4-73b9-4598-9b5a-98a4fdeac59c","leftValue":"={{ $json.status }}","rightValue":"INEXISTANT","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-448,384],"id":"dd4d3d6b-1474-4a3e-9e6b-a9afc2a9771c","name":"If2"},{"parameters":{"operation":"executeQuery","query":"select BPCNUM_0\n\n  from  BASE1.XREGNLR\nwhere BPCNUM_0='T7121' and  NETAP_0 <> 0"},"type":"n8n-nodes-base.microsoftSql","typeVersion":1.1,"position":[64,352],"id":"bc787811-7f64-4d8f-9122-