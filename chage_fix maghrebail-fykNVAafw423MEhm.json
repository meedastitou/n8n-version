n par ligne\nreturn lignes.map(j => ({\n  json: {\n    CodeFrs: (j.BPSNUM_0 ?? '').toString().trim(),\n    BLFrs: \"BL_\" + j.numero_facture,\n    DateBC: formatDateFacture(j.ORDDAT_0),\n    N_BC: j.POHNUM_0,\n    CodeArticle: j.ITMREF_0,\n    Quantite: 1,\n    N_B_transport: \"BL_\" + j.numero_facture,\n    Matricule: 'A',\n    Poids: 0.01,\n    Marque: j.XMARQ_0,\n    observation: \"\",\n    N_Facture: j.numero_facture,\n    email_expediteur: \"developpeur.ia@jbel-annour.ma\",\n    montant_ht: j.montant_ht,\n    facture_id\n  }\n}));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1216,48],"id":"bcd88dd9-a25a-4840-b7b6-c62c131bd589","name":"Code"},{"parameters":{"jsCode":"// Node Code (JavaScript) - Run Once for All Items\nconst aggItems = $('Aggregate').all(); // nom exact du node Aggregate\nconst outputItems = [];\n\n// PSHNUM_0 : pris une seule fois sur l'input courant (node précédent ce Code)\nconst numero_da = $input.first()?.json?.PSHNUM_0 ?? null;\n\nfor (const item of aggItems) {\n  const dataArray = Array.isArray(item.json.data) ? item.json.data : [];\n\n  for (const row of dataArray) {\n    outputItems.push({\n      json: {\n        ...row,\n        PSHNUM_0: row.PSHNUM_0 ?? numero_da\n      }\n    });\n  }\n}\n\nreturn outputItems;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1152,32],"id":"94e98597-1959-432b-a7d3-1767e3e16a75","name":"Code2"},{"parameters":{"method":"POST","url":"http://192.168.1.211:8003/api/receiption/data","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"donnees\": {{ JSON.stringify($json.data) }},\n  \"email_expediteur\": \"developpeur.ia@jbel-annour.ma\",\n  \"headless\": false\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[976,32],"id":"b01b9eeb-bcb0-437e-aa74-080254271380","name":"HTTP Request"},{"parameters":{"assignments":{"assignments":[{"id":"88b6c0ac-d980-459a-a4cd-9920ad7ad2bc","name":"N_BC","value":"={{ $json.N_BC }}","type":"string"},{"id":"8dfc4ceb-1