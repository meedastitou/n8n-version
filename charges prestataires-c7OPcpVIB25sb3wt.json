{"createdAt":"2026-10-30T17:13:34.745Z","updatedAt":"2026-10-30T23:13:42.000Z","id":"c7OPcpVIB25sb3wt","name":"charges Prestataires","active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"prestataire","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-688,192],"id":"da884dfd-17db-41e0-ab9e-23913f06eab0","name":"Webhook","webhookId":"43fc85d1-96e4-4e48-9c49-0d0c78f55d0c"},{"parameters":{"jsCode":"// Entrée : item(s) du webhook, chaque item contient body.lignes[]\nconst bodies = $input.all()\n  .flatMap(i => (Array.isArray(i.json) ? i.json : [i.json]))\n  .map(j => j.body ?? j);   // accepte aussi un item déjà \"aplati\" (sans body)\n\n// Identifiant généré UNE seule fois, partagé par toutes les lignes\nconst now = new Date();\nconst periode = `${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, '0')}`;\n\nconst alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\nlet suffix = '';\nfor (let i = 0; i < 6; i++) {\n  suffix += alphabet[Math.floor(Math.random() * alphabet.length)];\n}\n\nconst idDA = `DA-CF-${periode}-${suffix}`;\n\n// Un item de sortie par ligne (body.lignes), avec le même id_da\nconst out = [];\nfor (const b of bodies) {\n  const lignes = Array.isArray(b.lignes) ? b.lignes : [];\n  lignes.forEach((l, idx) => {\n    out.push({\n      json: {\n        id_da: idDA,\n        num_ligne: idx + 1,\n        nom: b.nom,\n        prenom: b.prenom,\n        fonction: b.fonction,\n        service: b.service,\n        code_tiers: b.code_tiers,\n        article_code: l.article_code,\n        article_designation: l.article_designation,\n        quantite: l.quantite,\n        montant: l.montant,\n      },\n    });\n  });\n}\n\nreturn out;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-432,192],"id":"db5f4c85-c04b-4543-9025-8db19207b11d","name":"Code"},{"parameters":{"assignments":{"assignments":[{"id":"14c4387d-7295-4dd1-a3cb-060e77afd780","name":"code_article","value":"={{ $json.article_code 