             </tr>\n                        <tr>\n                          <td style=\"padding: 3px 0; font-family: Arial, sans-serif; font-size: 13px; line-height: 18px; color: #856404;\">&#8226; Disponibilite</td>\n                        </tr>\n                        <tr>\n                          <td style=\"padding: 3px 0; font-family: Arial, sans-serif; font-size: 13px; line-height: 18px; color: #856404;\">&#8226; Marque proposee (si differente)</td>\n                        </tr>\n                        <tr>\n                          <td style=\"padding: 3px 0; font-family: Arial, sans-serif; font-size: 13px; line-height: 18px; color: #856404;\">&#8226; Quantite disponible</td>\n                        </tr>\n                      </table>\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n            \n            \n            \n            <tr>\n              <td style=\"padding: 0 40px;\" bgcolor=\"#ffffff\">\n                <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\">\n                  <tr>\n                    <td style=\"border-top: 2px solid #e0e0e0; font-size: 1px; line-height: 1px;\">&nbsp;</td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n            \n            <tr>\n              <td style=\"padding: 20px 40px 30px 40px;\" bgcolor=\"#ffffff\">\n                <p style=\"margin: 0 0 5px 0; font-family: Arial, sans-serif; font-size: 12px; line-height: 18px; color: #333333; font-weight: bold;\">Service Achats</p>\n                <p style=\"margin: 0 0 5px 0; font-family: Arial, sans-serif; font-size: 12px; line-height: 18px; color: #666666;\">acheteur.1@jbel-annour.ma</p>\n                <p style=\"margin: 0 0 15px 0; font-family: Arial, sans-serif; font-size: 12px; line-height: 18px; color: #666666;\">+212 668743516</p>\n                <!-- <p style=\"margin: 0; font-family: