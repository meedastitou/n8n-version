{"createdAt":"2026-11-19T14:12:11.065Z","updatedAt":"2026-11-25T15:20:07.000Z","id":"KNkU7oNXADeveVsp","name":"CHARGE FIX CHAUFFEUR","active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"chauffeurs","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-960,80],"id":"c1ef2c3a-0a61-4c71-9d26-bb3b2ff277c0","name":"Webhook","webhookId":"4fdf6db1-a342-4949-82e0-991116a4ee47"},{"parameters":{"jsCode":"const results = [];\n\nfunction genererIdDA() {\n  const now = new Date();\n  const periode = `${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, '0')}`;\n\n  const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n  let suffix = '';\n  for (let i = 0; i < 6; i++) {\n    suffix += alphabet[Math.floor(Math.random() * alphabet.length)];\n  }\n\n  return `DA-CF-${periode}-${suffix}`;\n}\n\nfor (const item of $input.all()) {\n  const body = item.json.body ?? item.json;\n\n  const {\n    chauffeur,\n    code_fournisseur,\n    date_debut,\n    date_fin,\n    nb_voyages,\n  } = body;\n\n  results.push({\n    json: {\n      id_da: genererIdDA(),\n      chauffeur,\n      code_fournisseur,\n      date_debut,\n      date_fin,\n      quantite: nb_voyages,\n    },\n  });\n}\n\nreturn results;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-720,80],"id":"f9deecf9-3dde-483b-842a-760a55b9aeaa","name":"Code"},{"parameters":{"assignments":{"assignments":[{"id":"14c4387d-7295-4dd1-a3cb-060e77afd780","name":"code_article","value":"=A09986","type":"string"},{"id":"3c0c1125-26aa-464e-85a3-375b86bd6b0b","name":"quantite","value":"={{ $json.quantite }}","type":"number"},{"id":"6d78e28b-a959-4252-b489-405195615dfe","name":"prix_unitaire_ht","value":"=45.83330","type":"number"},{"id":"72823a63-5273-4aa4-8146-158faee91775","name":"marque","value":"PRESTATION","type":"string"},{"id":"27c60cc6-dbc7-438d-8455-8971c7e516a1","name":"code_fournisseur","value":"={{ $json.code_fournisseur }}","type":"string"},{"id":"e16b0c80-2521-4b