{"createdAt":"2026-10-22T09:40:56.136Z","updatedAt":"2026-11-23T11:26:02.000Z","id":"iJanpFASOev697DA","name":"allimentation database ALLMATE","active":true,"isArchived":false,"nodes":[{"parameters":{"operation":"executeQuery","query":"SELECT\n    DNS.DA,\n    DNS.Article,\n    DNS.DésignationArticle,\n    DNS.QteDA,\n    DAD.XMARQ_0 AS marque,\n    DNS.STU_0 AS Unite,\n    DNS.Famille,\n    DNS.SousFamille,\n    DNS.CatégorieFamille,\n    DNS.Observation,\n    DNS.DateDA AS date_da\nFROM x3.BASE1.Y_DA_NON_SOLDEES DNS\nLEFT JOIN x3.BASE1.PREQUIS DA\n    ON DA.PSHNUM_0 = DNS.DA\nINNER JOIN x3.BASE1.PREQUISD DAD\n    ON DAD.PSHNUM_0 = DA.PSHNUM_0\n    AND DAD.ITMREF_0 = DNS.Article\nWHERE DNS.Famille NOT LIKE 'SERVICE%'\n  AND DNS.Famille NOT LIKE 'LOGISTIQUE%'\n  AND DNS.Famille NOT LIKE 'R.H'\n  AND DNS.Famille NOT LIKE 'ELECTRICITE'\n  AND DNS.Article NOT IN ('A09985', 'A10107', 'A10136')\n  AND DNS.DateDA >= CAST('{{ $json.query.date_debut }}' AS DATE)\n  AND DNS.DateDA <  DATEADD(DAY, 1, CAST('{{ $json.query.date_fin }}' AS DATE))\n  AND DA.CLEFLG_0 = 1;"},"type":"n8n-nodes-base.microsoftSql","typeVersion":1.1,"position":[-80,-144],"id":"dbc6cbbd-78d1-4a89-b043-a453f168de23","name":"Microsoft SQL","credentials":{"microsoftSql":{"id":"HW9ko65N6UH3Mtv7","name":"SageX3_241"}}},{"parameters":{"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[-512,1168],"id":"764fe050-1e35-47dc-a3cb-df1fc9054372","name":"Loop Over Items","disabled":true},{"parameters":{"operation":"executeQuery","query":"INSERT INTO master.dbo.demande_achat_non_solde\n    (da, article, designation_article, qte_da, marque, unite, famille,\n     sous_famille, categorie_famille, observation, date_da)\nSELECT\n    '{{ $json.DA }}',\n    '{{ $json.Article }}',\n    '{{ ($json[\"DésignationArticle\"] || \"\").replace(/'/g, \"''\") }}',\n    {{ $json.QteDA ?? \"NULL\" }},\n    '{{ ($json.marque || \"\").replace(/'/g, \"''\") }}',\n    '{{ $json.Unite }}',\n    '{{ ($json.Famill