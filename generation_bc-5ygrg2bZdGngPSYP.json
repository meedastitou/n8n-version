oupes).map(([da, lignes]) => ({\n  json: {\n    data: lignes,\n  },\n}));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[336,-80],"id":"2a691583-ca83-456d-bcaf-ead0291a0717","name":"Code"},{"parameters":{"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[928,-288],"id":"cd868aa3-b91c-451a-b0ab-1413202ce408","name":"Loop Over Items"},{"parameters":{},"type":"n8n-nodes-base.noOp","name":"Replace Me","typeVersion":1,"position":[1104,-224],"id":"6d340fd4-1f3f-45fb-90da-c22b58d3a1ac"},{"parameters":{"method":"POST","url":"http://192.168.1.211:8003/api/bonne-commande/data","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"donnees\": {{ JSON.stringify($json.data) }},\n  \"email_expediteur\": \"developpeur.ia@jbel-annour.ma\",\n  \"headless\": false\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[560,-80],"id":"918216fa-ab80-49e4-b669-6978f725d886","name":"HTTP Request"},{"parameters":{"amount":3},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[1328,112],"id":"59a3044a-a26b-482d-ab59-ea5ccede3907","name":"Wait","webhookId":"e9752332-2027-4444-881b-73300154e3ca"},{"parameters":{"operation":"executeQuery","query":"select \n  '{{ $json.code_article }}' as code_article,\n  '{{ $json.prix_unitaire_ht }}' as prix_unitaire_ht,\n  '{{ $json.marque }}' as marque,\n  '{{ $json.code_fournisseur }}' as code_fournisseur,\n  '{{ $json.numero_da }}' as numero_da,\n  '{{ $json.affaire }}' as affaire,\n  WEB_0 as email_fournisseur,\n  TEL_0 as tel_fournisseur\n  from BASE1.BPADDRESS\n  where BPANUM_0='{{ $json.code_fournisseur }}'\n"},"type":"n8n-nodes-base.microsoftSql","typeVersion":1.1,"position":[80,-80],"id":"b6730dfe-d0c5-4b83-a2a5-b200e3e67207","name":"Microsoft SQL","credentials":{"microsoftSql":{"id":"HW9ko65N6UH3Mtv7","name":"SageX3_241"}}},{"parameters":{"assignments":{"assignments":[{"id":"ff13622f-932b-4b86-916b-1931de5ed758","name":"numero_da","value":"={{ $json.body.articles[0].num